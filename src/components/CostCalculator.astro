---
import costsData from '../data/calculator-costs.json';
import type { PractitionerType } from '../scripts/cost-calculator';

// One question per screen. The practitioner is decided by a short branching
// quiz (who → general/clinical or which one → fee → GP), and the receipt
// beside it fills in as answers arrive. src/scripts/cost-calculator.ts owns
// the routing, the state (sessionStorage) and the receipt maths; this file
// renders every screen up front, with only the first one visible.
const types = costsData.practitionerTypes as PractitionerType[];
const defaultType = types[0];
const psychiatrist = types.find((t) => t.firstVisit);

// The pre-answered scenario the page opens on: a general psychologist at the
// typical fee. The numbers below are SSR'd into the done screen and receipt,
// and must match defaultState() in src/scripts/cost-calculator.ts.
const defType = types.find((t) => t.id === 'general-psychologist') ?? defaultType;
const defFee = defType.chips[1];
const aud = new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'AUD' });
const audWhole = new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'AUD', minimumFractionDigits: 0, maximumFractionDigits: 0 });
const gpRange = `Free to ${audWhole.format(costsData.gpCostPrivate)}`;
const answerSentence = `Seeing a general psychologist with a care plan usually costs about ${audWhole.format(defFee)} a session. Medicare gives back ${aud.format(defType.rebate)}. You pay about ${audWhole.format(Math.round(defFee - defType.rebate))}.`;

// Quiz answer: a full-width card, body-weight text, sub-label optional.
const answerCard = 'flex w-full min-h-14 flex-col items-start justify-center gap-0.5 rounded-[10px] border border-ink-green/16 bg-white px-4 py-3 text-left text-base leading-snug text-body transition-colors duration-150 hover:border-primary hover:bg-primary-light hover:text-heading focus-visible:outline-3 focus-visible:outline-primary focus-visible:outline-offset-3 disabled:cursor-wait disabled:opacity-70 cursor-pointer';
const answerSub = 'text-[13.5px] leading-snug text-meta-sage';

const stepLabel = 'text-sm font-medium text-primary';
const backButton = 'text-sm font-medium text-body hover:text-heading transition-colors focus-visible:outline-3 focus-visible:outline-primary focus-visible:outline-offset-3 cursor-pointer';
const primaryButton = 'inline-flex min-h-11 items-center justify-center rounded-[10px] bg-primary hover:bg-primary-dark transition-colors duration-150 px-6 py-[13px] text-base font-semibold text-white focus-visible:outline-3 focus-visible:outline-primary focus-visible:outline-offset-3 cursor-pointer';
const changeLink = 'text-sm font-semibold text-primary underline underline-offset-[3px] hover:text-primary-mid focus-visible:outline-3 focus-visible:outline-primary focus-visible:outline-offset-3 cursor-pointer';

const fieldInput = 'w-full border border-ink-green/16 rounded-[10px] px-4 py-2.5 text-heading font-semibold bg-white hover:border-primary/50 transition-colors focus:ring-2 focus:ring-primary focus:border-primary';

// Quick-pick fee chips. `aria-pressed` is the selected state, kept in sync
// by src/scripts/cost-calculator.ts.
const feeChip = 'inline-flex min-h-9 items-center rounded-[10px] border border-ink-green/16 bg-white px-3 py-1.5 text-sm font-semibold text-heading transition-colors duration-150 hover:border-primary hover:bg-primary-light aria-pressed:border-primary aria-pressed:bg-primary-light aria-pressed:ring-1 aria-pressed:ring-primary cursor-pointer';
const chipNames = ['Lower', 'Typical', 'Higher'] as const;

// Most practitioners have one fee; psychiatrists have a first appointment
// and follow-ups. Both groups are rendered and the script shows one.
const feeGroups = [
  {
    name: 'single',
    fields: [{ id: 'session-fee', label: 'Session fee ($)', chips: defaultType.chips, max: 1000 }],
  },
  {
    name: 'psychiatrist',
    fields: [
      { id: 'first-fee', label: 'First appointment fee ($)', chips: psychiatrist?.firstVisit?.chips ?? defaultType.chips, max: 1500 },
      { id: 'follow-up-fee', label: 'Follow-up fee ($)', chips: psychiatrist?.chips ?? defaultType.chips, max: 1000 },
    ],
  },
];

// The four "someone else" practitioners, in JSON order.
const otherTypes = types.filter((t) => !t.psychologist && !t.firstVisit);

// Receipt row: label · dotted leader · amount. The empty leader span is a
// baseline-aligned flex item, so its bottom border sits on the text baseline.
const receiptRow = 'flex items-baseline gap-2 text-[15px] leading-snug';
const receiptLeader = 'min-w-4 flex-1 border-b border-dotted border-ink-green/25';
const receiptAmount = 'font-medium text-heading tabular-nums';
const receiptTotal = 'font-display font-semibold text-[30px] sm:text-[34px] leading-none tracking-[-0.02em] text-heading tabular-nums';

// Summary row on the last screen.
const summaryRow = 'flex items-baseline justify-between gap-4 py-3 border-t border-hairline first:border-t-0';
---
<div id="cost-calculator" class="bg-paper-cream border border-pencil rounded-[14px] p-6 sm:p-8 md:p-10">
  <div class="grid gap-8 md:grid-cols-[1fr_minmax(280px,0.85fr)] md:gap-10">

    <!-- Quiz: every screen is rendered; the script shows one at a time. -->
    <div class="calc-screens" data-calc-screens role="group" aria-label="Mental health cost calculator">
      <p class="sr-only" aria-live="polite" aria-atomic="true" data-calc-live></p>
      <noscript><p class="text-sm text-body mb-4">This calculator needs JavaScript to work.</p></noscript>

      <!-- 1. Who (reached via Change or Start again; the page opens on "done") -->
      <section class="calc-screen calc-screen--hidden" data-calc-screen="who">
        <div class="flex items-center justify-between gap-4 mb-3">
          <p class={stepLabel} data-calc-progress>Question 1 of 4</p>
        </div>
        <h2 class="calc-heading mb-4" tabindex="-1" data-calc-heading>Who will you be seeing?</h2>
        <div class="grid gap-3" role="group" aria-label="Who will you be seeing?">
          <button type="button" class={answerCard} data-calc-answer data-branch="psychologist">Psychologist</button>
          <button type="button" class={answerCard} data-calc-answer data-branch="psychiatrist" data-type="psychiatrist">Psychiatrist</button>
          <button type="button" class={answerCard} data-calc-answer data-branch="other">
            <span>Someone else</span>
            <span class={answerSub}>Social worker, OT, counsellor or psychotherapist</span>
          </button>
          <button type="button" class={answerCard} data-calc-answer data-branch="unknown" data-type="general-psychologist" data-assume="unknown">I don't know yet</button>
        </div>
        <p class="mt-4 text-[13.5px] leading-snug text-meta-sage">
          Not sure who to see? <a href="/practitioners" class={changeLink}>Compare your options</a>
        </p>
      </section>

      <!-- 2a. Psychologist: general or clinical -->
      <section class="calc-screen calc-screen--hidden" data-calc-screen="psych">
        <div class="flex items-center justify-between gap-4 mb-3">
          <p class={stepLabel} data-calc-progress>Question 2 of 4</p>
          <button type="button" class={backButton} data-calc-back>&larr; Back</button>
        </div>
        <h2 class="calc-heading mb-4" tabindex="-1" data-calc-heading>Do you know if they're general or clinical?</h2>
        <div class="grid gap-3" role="group" aria-label="General or clinical">
          <button type="button" class={answerCard} data-calc-answer data-type="general-psychologist">General</button>
          <button type="button" class={answerCard} data-calc-answer data-type="clinical-psychologist">Clinical</button>
          <button type="button" class={answerCard} data-calc-answer data-type="general-psychologist" data-assume="not-sure">
            <span>Not sure</span>
            <span class={answerSub}>Most are general</span>
          </button>
        </div>
      </section>

      <!-- 2b. Someone else: which one -->
      <section class="calc-screen calc-screen--hidden" data-calc-screen="other">
        <div class="flex items-center justify-between gap-4 mb-3">
          <p class={stepLabel} data-calc-progress>Question 2 of 4</p>
          <button type="button" class={backButton} data-calc-back>&larr; Back</button>
        </div>
        <h2 class="calc-heading mb-4" tabindex="-1" data-calc-heading>Which one?</h2>
        <div class="grid gap-3" role="group" aria-label="Which practitioner">
          {otherTypes.map((t) => (
            <button type="button" class={answerCard} data-calc-answer data-type={t.id}>{t.label}</button>
          ))}
        </div>
      </section>

      <!-- 3. Fee: the one screen with typed input, so it's a form. -->
      <form class="calc-screen calc-screen--hidden" data-calc-screen="fee" novalidate>
        <div class="flex items-center justify-between gap-4 mb-3">
          <p class={stepLabel} data-calc-progress>Question 3 of 4</p>
          <button type="button" class={backButton} data-calc-back>&larr; Back</button>
        </div>
        <h2 class="calc-heading mb-1" tabindex="-1" data-calc-heading data-calc-fee-heading>Do you know what they charge per session?</h2>
        <p class="text-[13.5px] leading-snug text-meta-sage mb-4" data-calc-assume-note hidden></p>
        <p class="text-[13.5px] leading-snug text-meta-sage mb-4" data-calc-fee-hint>Their website or booking page will say. If not, ask when you call.</p>

        {feeGroups.map((g) => (
          <div class="space-y-6" data-fee-group={g.name} hidden={g.name !== 'single'}>
            {g.fields.map((f) => (
              <div data-fee-field={f.id}>
                <label for={f.id} class="block text-sm font-semibold text-body mb-1">{f.label}</label>
                <input
                  type="number"
                  id={f.id}
                  name={f.id}
                  min="0"
                  max={f.max}
                  step="5"
                  inputmode="decimal"
                  placeholder={`e.g. ${f.chips[1]}`}
                  class={fieldInput}
                />
                <div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Typical fees">
                  {chipNames.map((name, i) => (
                    <button type="button" class={feeChip} data-fee-chip={f.chips[i]} data-chip-label={name} aria-pressed="false">{name} ${f.chips[i]}</button>
                  ))}
                </div>
              </div>
            ))}
          </div>
        ))}

        <button type="button" class={`mt-4 ${answerCard}`} data-calc-typical>I'm just looking &mdash; use a typical fee (${defFee})</button>

        <p class="mt-3 text-sm font-medium text-accent-red-soft" role="alert" data-fee-error hidden>Enter a fee to continue.</p>
        <div class="mt-6">
          <button type="submit" class={primaryButton} data-calc-next>Next</button>
        </div>
      </form>

      <!-- 4. GP -->
      <section class="calc-screen calc-screen--hidden" data-calc-screen="gp">
        <div class="flex items-center justify-between gap-4 mb-3">
          <p class={stepLabel} data-calc-progress>Question 4 of 4</p>
          <button type="button" class={backButton} data-calc-back>&larr; Back</button>
        </div>
        <h2 class="calc-heading mb-4" tabindex="-1" data-calc-heading>Do you pay anything to see your GP?</h2>
        <div class="grid gap-3" role="group" aria-label="Do you pay anything to see your GP">
          <button type="button" class={answerCard} data-calc-answer data-gp="free">No, it's free</button>
          <button type="button" class={answerCard} data-calc-answer data-gp="paid">Yes, about ${costsData.gpCostPrivate}</button>
        </div>
      </section>

      <!-- 5. Done: the screen the page opens on, pre-filled with the default
           scenario. Every answer is changeable. -->
      <section class="calc-screen" data-calc-screen="done">
        <div class="flex items-center justify-between gap-4 mb-3">
          <p class={stepLabel} data-calc-progress>Your costs</p>
          <!-- No Back here: this is the landing screen, and the Change links
               cover revisiting any answer. -->
        </div>
        <h2 class="calc-heading mb-3" tabindex="-1" data-calc-heading>What a session costs</h2>
        <p class="text-body leading-relaxed mb-5" data-calc-answer-line>{answerSentence}</p>
        <dl class="rounded-[10px] border border-ink-green/16 bg-white px-4">
          <div class={summaryRow}>
            <div class="min-w-0">
              <dt class="text-[12.5px] font-semibold text-meta-sage">Seeing</dt>
              <dd class="text-base font-semibold text-heading" data-summary-type>{defType.label}</dd>
            </div>
            <button type="button" class={changeLink} data-calc-goto="who">Change</button>
          </div>
          <div class={summaryRow}>
            <div class="min-w-0">
              <dt class="text-[12.5px] font-semibold text-meta-sage" data-summary-fee-label>Session fee</dt>
              <dd class="text-base font-semibold text-heading tabular-nums" data-summary-fee>{audWhole.format(defFee)}</dd>
            </div>
            <button type="button" class={changeLink} data-calc-goto="fee">Change</button>
          </div>
          <div class={summaryRow} data-summary-gp-row>
            <div class="min-w-0">
              <dt class="text-[12.5px] font-semibold text-meta-sage">GP visit</dt>
              <dd class="text-base font-semibold text-heading" data-summary-gp>{gpRange}</dd>
            </div>
            <button type="button" class={changeLink} data-calc-goto="gp">Change</button>
          </div>
        </dl>
        <div class="mt-5">
          <button type="button" class={backButton} data-calc-reset>Start again</button>
        </div>
      </section>
    </div>

    <!-- Receipt: fills in as the answers arrive -->
    <div class="md:self-start">
      <div id="calc-receipt" class="bg-white border border-ink-green/12 rounded-[10px] p-5 sm:p-6">
        <p class="text-[12.5px] font-semibold text-meta-sage">What you'll pay</p>

        <!-- Most practitioners: one fee, one rebate. SSR'd with the default
             scenario so the answer is the first paint. -->
        <div data-receipt-body="single">
          <div class="mt-4 space-y-2.5">
            <div class={receiptRow}>
              <span class="text-body">Session fee</span>
              <span class={receiptLeader} aria-hidden="true"></span>
              <span class={receiptAmount} data-receipt-fees>{aud.format(defFee)}</span>
            </div>
            <div class={receiptRow}>
              <span class="text-body">Medicare pays back</span>
              <span class={receiptLeader} aria-hidden="true"></span>
              <span class="font-medium text-primary tabular-nums" data-receipt-rebate>&minus;{aud.format(defType.rebate)}</span>
            </div>
          </div>
          <div class="mt-4 border-t border-hairline pt-4">
            <div class="flex items-baseline justify-between gap-3" aria-live="polite" aria-atomic="true">
              <span class="text-[15px] font-semibold text-heading">You pay per session</span>
              <span class={receiptTotal} data-receipt-total>{aud.format(defFee - defType.rebate)}</span>
            </div>
          </div>
        </div>

        <!-- Psychiatrists: first appointment, then follow-ups -->
        <div data-receipt-body="psychiatrist" hidden>
          <div class="mt-4 space-y-2.5">
            <div class={receiptRow}>
              <span class="text-body">First appointment</span>
              <span class={receiptLeader} aria-hidden="true"></span>
              <span class={receiptAmount} data-receipt-first-fee>&mdash;</span>
            </div>
            <div class={receiptRow}>
              <span class="text-body">Medicare pays back</span>
              <span class={receiptLeader} aria-hidden="true"></span>
              <span class="font-medium text-primary tabular-nums" data-receipt-first-rebate>&mdash;</span>
            </div>
          </div>
          <div class="mt-3 flex items-baseline justify-between gap-3">
            <span class="text-[14px] font-semibold text-heading">You pay, first appointment</span>
            <span class="font-display font-semibold text-[22px] leading-none tracking-[-0.02em] text-heading tabular-nums" data-receipt-first-total>&mdash;</span>
          </div>
          <div class="mt-4 border-t border-hairline pt-4 space-y-2.5">
            <div class={receiptRow}>
              <span class="text-body">Follow-up</span>
              <span class={receiptLeader} aria-hidden="true"></span>
              <span class={receiptAmount} data-receipt-follow-fee>&mdash;</span>
            </div>
            <div class={receiptRow}>
              <span class="text-body">Medicare pays back</span>
              <span class={receiptLeader} aria-hidden="true"></span>
              <span class="font-medium text-primary tabular-nums" data-receipt-follow-rebate>&mdash;</span>
            </div>
          </div>
          <div class="mt-3 flex items-baseline justify-between gap-3" aria-live="polite" aria-atomic="true">
            <span class="text-[15px] font-semibold text-heading">You pay per follow-up</span>
            <span class={receiptTotal} data-receipt-follow-total>&mdash;</span>
          </div>
        </div>

        <!-- One-off GP visit (care plan or referral). Shown for the default
             scenario; hidden for practitioners you book directly. -->
        <div class="mt-4 border-t border-hairline pt-4" data-receipt-gp-part>
          <p class="text-[12.5px] font-semibold text-meta-sage">One-off to get started</p>
          <div class={`mt-2.5 ${receiptRow}`}>
            <span class="text-body" data-receipt-gp-label>GP visit (care plan)</span>
            <span class={receiptLeader} aria-hidden="true"></span>
            <span class={receiptAmount} data-receipt-gp>{gpRange}</span>
          </div>
        </div>

        <!-- Must match CAP_NOTE in src/scripts/cost-calculator.ts. -->
        <p class="mt-3 text-[13px] leading-snug text-meta-sage" data-receipt-note>
          Medicare covers up to {costsData.maxMedicareSessions} sessions like this each calendar year.
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  /* All screens share one grid cell, so the card takes the height of its
     tallest screen and never resizes between questions — the receipt beside
     it (and the page below) stays put. Inactive screens stay display: block
     and hide via visibility, which also removes them from the a11y tree and
     tab order. A class (not the hidden attribute) toggles them because
     Tailwind's preflight forces [hidden] to display: none !important. */
  .calc-screens {
    display: grid;
  }

  .calc-screen {
    grid-area: 1 / 1;
    align-self: start;
  }

  .calc-screen--hidden {
    opacity: 0;
    visibility: hidden;
    /* Inert immediately, even while still fading out. */
    pointer-events: none;
  }

  /* Same screen typography as the pathway quiz (Switzer 600 23px / -0.012em). */
  .calc-heading {
    font-family: var(--font-display);
    font-size: 23px;
    font-weight: 600;
    letter-spacing: -0.012em;
    line-height: 1.375;
    color: var(--color-heading);
  }

  /* Sequenced fade between screens: the outgoing screen fades out quickly,
     then the incoming one fades in with a soft rise. Both occupy the same
     grid cell, so no layout moves. Reduced motion gets the instant swap from
     the base rules above. */
  @media (prefers-reduced-motion: no-preference) {
    .calc-screen {
      transition:
        opacity 240ms ease-out 110ms,
        transform 240ms ease-out 110ms,
        visibility 0s 0s;
    }

    .calc-screen--hidden {
      transform: translateY(6px);
      transition:
        opacity 140ms ease-in,
        transform 140ms ease-in,
        visibility 0s 140ms;
    }
  }
</style>

<script>
  import '../scripts/cost-calculator.ts';
</script>
