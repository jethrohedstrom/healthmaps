---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CostCalculator from '../components/CostCalculator.astro';
import costs from '../data/calculator-costs.json';

const lastVerified = new Date(costs.lastUpdated).toLocaleDateString('en-AU', {
  month: 'long',
  year: 'numeric',
});

// FAQ dollar figures come from the calculator data so they can't drift from it.
const psychiatrist = costs.practitionerTypes.find((p) => p.id === 'psychiatrist')!;
const dollars = (n: number) => `$${Math.round(n)}`;
const [short, mid, long] = psychiatrist.followUpLengths!.map((l) => dollars(l.rebate));

const faqs = [
  {
    q: 'Why do I still have to pay something?',
    a: `<p>Medicare pays back a fixed amount for each session, called the <strong>rebate</strong>. Most practitioners charge more than that. The difference is your <strong>out-of-pocket cost</strong>, sometimes called the gap. That's the number the calculator shows.</p>`,
  },
  {
    // REVIEW: AI-drafted claim — psychologists/social workers/OTs need an MHCP + GP referral; psychiatrists need a standard referral; counsellors and psychotherapists are outside Better Access, some extras cover part.
    q: 'Do I need to see a GP first?',
    a: `<ul class="dot-list space-y-2">
      <li><strong>Psychologist, mental health social worker or OT:</strong> yes. A GP writes a <a href="/pathway/#through-gp" class="font-semibold text-primary underline underline-offset-2">Mental Health Care Plan</a> and a referral. Without them there's no rebate.</li>
      <li><strong>Psychiatrist:</strong> yes, but a standard GP referral is enough. You don't need a plan.</li>
      <li><strong>Counsellor or psychotherapist:</strong> no. Medicare doesn't cover them, so you pay the full fee. Some private health extras policies cover part of it.</li>
    </ul>`,
  },
  {
    // REVIEW: AI-drafted claim — 10 Better Access sessions per calendar year, GP review after 6; no yearly cap for psychiatrists.
    q: 'How many sessions does Medicare cover?',
    a: `<p>Up to ${costs.maxMedicareSessions} sessions per calendar year (January to December) with a psychologist, social worker or OT. After the first 6, you go back to the GP for a short review before sessions 7–${costs.maxMedicareSessions}. Psychiatrists have no yearly cap.</p>`,
  },
  {
    // REVIEW: AI-drafted claim — Easyclaim rebates go only to eftpos debit cards; app/myGov claims go to the Medicare-registered bank account.
    q: 'How do I get the money back?',
    a: `<p>You pay the full fee on the day, and any card works. If the clinic claims the rebate for you, Medicare can only pay it onto a <strong>debit card</strong>, not a credit card. Otherwise you claim in the Medicare app, and the money goes to the bank account you've registered, usually within a day or two.</p>`,
  },
  {
    q: 'Can I pay nothing at all?',
    a: `<p>Yes, if the practitioner <strong>bulk-bills</strong>. They charge only the rebate, so you pay $0. Bulk-billing practitioners often have longer waits.</p>`,
  },
  {
    // REVIEW: AI-drafted claim — psychiatrist first appointment item 296, follow-ups items 302/304/306 by length (see calculator-costs.json reviewNotes).
    q: 'Why do psychiatrist rebates change?',
    a: `<p>The first appointment has the biggest rebate, about ${dollars(psychiatrist.firstVisit!.rebate)}. After that, the rebate depends on how long the appointment runs: about ${short} for 15–30 minutes, ${mid} for 30–45, and ${long} for 45–75. That's why the calculator asks how long your sessions are.</p>`,
  },
];
---
<BaseLayout
  title="Cost Calculator"
  description="See what you'll pay out-of-pocket per session after the Medicare rebate, whether you're seeing a psychologist, psychiatrist, counsellor or another mental health practitioner in Australia."
>
  <!-- Hero -->
  <section>
    <div class="max-w-body mx-auto px-4 py-16 md:py-20">
      <h1 class="font-display font-semibold text-[32px] md:text-[40px] tracking-[-0.02em] text-heading mt-3 mb-5 md:mb-6">Cost Calculator</h1>
      <p class="text-lg md:text-xl leading-relaxed text-body">
        It can be confusing to work out what healthcare costs and how you pay for it.
      </p>
      <p class="mt-4 md:mt-5 text-lg md:text-xl leading-relaxed text-body">
        This page aims to inform you of your cost for mental healthcare in Australia.
      </p>
      <ul class="dot-list mt-6 md:mt-8 space-y-2 md:space-y-3 text-base md:text-lg leading-relaxed text-body">
        <li>Different therapists charge different fees, so the price depends on who you see.</li>
        <li>If you just want a rough idea, you can pick from some of our common fees.</li>
      </ul>
      <p class="mt-8 md:mt-10 w-fit max-w-full rounded-[22px] border border-pencil bg-paper-cream px-5 py-3 md:px-6 md:py-3.5 text-[15px] leading-relaxed text-pretty text-body">
        Health Maps aims to be a guide. We don't currently have bookings or recommendations.
      </p>
    </div>
  </section>

  <!-- Calculator -->
  <section>
    <div class="max-w-4xl mx-auto px-4 pb-16 md:pb-20">
      <CostCalculator />
      <p class="text-sm text-meta-sage text-center mt-6">Rebate figures last checked: {lastVerified}</p>
    </div>
  </section>

  <!-- Explanation -->
  <section>
    <div class="max-w-body mx-auto px-4 py-16 md:py-20">
      <h2 class="font-display font-semibold text-[24px] md:text-[28px] tracking-[-0.02em] text-heading mb-6">How Medicare rebates work</h2>
      <div class="bg-white border border-pencil rounded-xl px-6 md:px-10 py-2">
        {faqs.map((faq, i) => (
          <details class:list={['accordion-item', i > 0 && 'border-t border-border']}>
            <summary class="summary-chevron">{faq.q}</summary>
            <div class="accordion-content !px-0 !pt-0 space-y-3 leading-relaxed text-body" set:html={faq.a} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Next steps -->
  <section class="bg-paper-cream border-t border-pencil">
    <div class="max-w-body mx-auto px-4 py-16 md:py-20 text-center">
      <h2 class="font-display font-semibold text-[22px] md:text-[24px] tracking-[-0.02em] text-heading mb-6">Know your numbers? Here's what's next.</h2>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="/tips/what-to-say-to-gp/"
          class="inline-flex min-h-11 items-center justify-center gap-1.5 rounded-[10px] border border-ink-green/16 bg-transparent px-6 py-3 font-semibold text-heading hover:bg-row-hover transition-colors duration-150"
        >
          What to say to your GP
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
        </a>
        <Button href="/pathway/" size="md" class="gap-1.5">
          See the full pathway
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
