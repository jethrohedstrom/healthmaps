---
import BaseLayout from '../layouts/BaseLayout.astro';
import CostCalculator from '../components/CostCalculator.astro';
---
<BaseLayout title="Mental Health Support in Australia, Explained">
  <!-- The homepage is the calculator: one left-aligned column, no card. It
       opens on a screen saying it's a cost calculator, and that line is the
       visible welcome, so the page title is for screen readers and search
       only. The button to the steps shows on the results screen (pathwayLink). -->
  <!-- Cream, not the sage of the other pages: with no card, the page itself
       is the surface the quiz sits on. -->
  <section class="bg-paper-cream">
    <div class="group px-6 pt-6 pb-16 md:pt-12 md:pb-24">
      <!-- While answering, the column hugs the single question. On the results
           screen it widens to fit the receipt beside the big number. -->
      <div class="mx-auto max-w-[42rem] group-has-[[data-calc-phase=done]]:max-w-4xl">
        <h1 class="sr-only">Mental health support in Australia, explained</h1>

        <CostCalculator pathwayLink intro />
      </div>
    </div>
  </section>

  <!-- Structured Data for SEO -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "HealthMaps",
    "description": "Navigate Australia's mental health system with clear, step-by-step guidance.",
    "url": "https://healthmaps.com.au",
  })} />
</BaseLayout>
